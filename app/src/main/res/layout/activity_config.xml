<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/config"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DDA0DD">

    <!-- Título -->
    <TextView
        android:id="@+id/txtHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configurações"
        android:textSize="24sp"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:textColor="#000000"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Imagem de Perfil -->
    <ImageButton
        android:id="@+id/btMNUcasa"
        android:layout_width="147dp"
        android:layout_height="98dp"
        android:background="@android:color/transparent"
        android:src="@drawable/perfil"
        app:layout_constraintTop_toBottomOf="@id/txtHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Botões -->
    <Button
        android:id="@+id/btLOGAcessar"
        android:layout_width="0dp"
        android:layout_height="39dp"
        android:backgroundTint="#FF6984"
        android:text="Perfil"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/btMNUcasa"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btLOGAcessar2"
        android:layout_width="0dp"
        android:layout_height="39dp"
        android:backgroundTint="#FF6984"
        android:text="Personalização"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/btLOGAcessar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btLOGAcessar3"
        android:layout_width="0dp"
        android:layout_height="39dp"
        android:backgroundTint="#FF6984"
        android:text="Segurança"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/btLOGAcessar2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btLOGAcessar4"
        android:layout_width="0dp"
        android:layout_height="39dp"
        android:backgroundTint="#FF6984"
        android:text="Armazenamento em Nuvem"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/btLOGAcessar3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btLOGAcessar5"
        android:layout_width="0dp"
        android:layout_height="39dp"
        android:backgroundTint="#FF6984"
        android:text="Conta"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/btLOGAcessar4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btLOGAcessar6"
        android:layout_width="0dp"
        android:layout_height="39dp"
        android:backgroundTint="#FF6984"
        android:text="Log Out"
        android:textSize="15sp"
        app:layout_constraintTop_toBottomOf="@id/btLOGAcessar5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp" />

    <!-- Barra de Navegação -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:itemIconTint="@color/selector_color"
        app:itemTextColor="@color/selector_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom_nav_menu" />
</androidx.constraintlayout.widget.ConstraintLayout>
